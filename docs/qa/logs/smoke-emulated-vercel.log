# Production build (dist/) served by a local emulation of Vercel routing: an existing file first, then vercel.json rewrites compiled with path-to-regexp 6. Not Vercel itself.
GET / -> 200 text/html; charset=utf-8
GET /runs/run-01 -> 200 text/html; charset=utf-8
GET /runs/run-20 -> 200 text/html; charset=utf-8
GET /runs/nope -> 200 text/html; charset=utf-8
GET /does-not-exist -> 200 text/html; charset=utf-8
GET /assets/does-not-exist-0000.js -> 404 text/plain

